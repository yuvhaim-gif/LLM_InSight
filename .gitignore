# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Secrets — NEVER commit
PI.py
.env
.env.*
!.env.example

# Runtime / working data (incl. Preference Studio: preferences.db, preferences_export/,
# preferences_regrade/). Folder is kept via .gitkeep so a fresh clone has the dir the app
# writes into; all actual runtime contents stay ignored.
data/*
!data/.gitkeep

# Backups (large session data). Folder kept via .gitkeep; contents ignored.
backup/*
!backup/.gitkeep

# IDE / tool caches
.zencoder/
.zenflow/
.pytest_cache/
.vscode/
*.swp
*.swo
*~

# SSL certs
*.pem
*.key
*.crt

# Grader settings (keep default only)
graderdata/*
!graderdata/default.jsonl

# Large video files (GIF used for README demo)
screenshots/*.mp4

# Wiki (local copy, managed via separate wiki repo)
wiki/

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Local planning docs (ignored from pushes)
docs/plan.md
